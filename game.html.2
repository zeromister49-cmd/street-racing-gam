<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>Street Racing 3D - High Graphics</title>
<!-- بارگذاری موتور گرافیکی 3D -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>

<style>
*{
    box-sizing: border-box;
    -webkit-tap-highlight-color: transparent;
    user-select: none;
}
html, body {
    margin: 0;
    padding: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: #000;
    font-family: Tahoma, Arial, sans-serif;
}
#gameContainer {
    position: relative;
    width: 100%;
    height: 100%;
}
#hud {
    position: absolute;
    top: 15px;
    left: 15px;
    right: 15px;
    display: flex;
    justify-content: space-between;
    z-index: 10;
    pointer-events: none;
}
.hudBox {
    color: #fff;
    background: rgba(15, 23, 42, 0.75);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 12px;
    padding: 8px 16px;
    font-size: 14px;
    font-weight: bold;
    backdrop-filter: blur(8px);
    box-shadow: 0 4px 20px rgba(0,0,0,0.4);
}
#nitroBox {
    position: absolute;
    top: 65px;
    left: 15px;
    width: 150px;
    background: rgba(15, 23, 42, 0.75);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 10px;
    padding: 5px;
    z-index: 10;
}
#nitroBar {
    height: 10px;
    width: 100%;
    background: linear-gradient(90deg, #ff8c00, #ff0055, #00d2ff);
    border-radius: 6px;
    transition: width 0.1s linear;
}
#damage {
    position: absolute;
    top: 65px;
    right: 15px;
    color: #fff;
    background: rgba(15, 23, 42, 0.75);
    border: 1px solid rgba(255, 255, 255, 0.2);
    padding: 6px 14px;
    border-radius: 10px;
    z-index: 10;
    font-weight: bold;
    font-size: 13px;
}
#controls {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 20px;
    z-index: 20;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 20px;
    pointer-events: none;
}
.controlGroup { display: flex; gap: 12px; }
.control {
    width: 65px;
    height: 65px;
    border: 1px solid rgba(255,255,255,0.3);
    border-radius: 18px;
    background: rgba(15, 23, 42, 0.75);
    color: #fff;
    font-size: 24px;
    font-weight: bold;
    pointer-events: auto;
    touch-action: none;
    display: flex;
    align-items: center;
    justify-content: center;
    backdrop-filter: blur(5px);
}
.control:active { background: rgba(255,255,255,0.3); }
#boost {
    width: 75px;
    height: 75px;
    border-radius: 50%;
    background: linear-gradient(135deg, #ff0055, #ff8c00);
    border: 2px solid #fff;
    font-size: 13px;
    box-shadow: 0 0 15px rgba(255, 0, 85, 0.6);
}
#garageBtn {
    width: 75px;
    height: 65px;
    background: linear-gradient(135deg, #1e3c72, #2a5298);
    font-size: 13px;
    pointer-events: auto;
}
#message {
    position: absolute;
    inset: 0;
    z-index: 50;
    display: none;
    align-items: center;
    justify-content: center;
    background: rgba(0,0,0,0.8);
    backdrop-filter: blur(10px);
}
#message.show { display: flex; }
.panel {
    width: min(90%, 400px);
    max-height: 85vh;
    overflow-y: auto;
    padding: 24px;
    text-align: center;
    color: #fff;
    background: #111827;
    border: 1px solid rgba(255,255,255,0.15);
    border-radius: 24px;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.7);
}
.panel h1 { margin: 0 0 12px; font-size: 22px; }
.panel p { color: #9ca3af; font-size: 14px; }
.primaryBtn {
    border: 0;
    border-radius: 12px;
    padding: 14px 25px;
    background: linear-gradient(90deg, #ef4444, #dc2626);
    color: #fff;
    font-size: 15px;
    font-weight: bold;
    width: 100%;
    margin-top: 15px;
    cursor: pointer;
}
.carGrid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    margin: 15px 0;
}
.carCard {
    background: #1f2937;
    border: 2px solid transparent;
    border-radius: 14px;
    padding: 12px;
    cursor: pointer;
    transition: all 0.2s;
}
.carCard.selected {
    border-color: #38bdf8;
    background: #1e293b;
    box-shadow: 0 0 15px rgba(56, 189, 248, 0.3);
}
</style>
</head>
<body>

<div id="gameContainer">
    <div id="hud">
        <div class="hudBox" id="stageText">شهر ۱ - مرحله ۱/۵۰</div>
        <div class="hudBox" id="speedText">۰ km/h</div>
        <div class="hudBox" id="distanceText">۰ / ۱۵۰۰ متر</div>
    </div>
    <div id="nitroBox"><div id="nitroBar"></div></div>
    <div id="damage">آسیب: ۰ / ۲</div>

    <div id="controls">
        <div class="controlGroup">
            <button class="control" id="left">◀</button>
            <button class="control" id="right">▶</button>
        </div>
        <button class="control" id="boost">NITRO</button>
        <button class="control" id="garageBtn">🚗 گاراژ</button>
    </div>

    <div id="message">
        <div class="panel" id="panelContent">
            <h1 id="messageTitle">مرحله تمام شد</h1>
            <p id="messageText">آماده مرحله بعدی؟</p>
            <button class="primaryBtn" id="nextButton">ادامه</button>
        </div>
    </div>
</div>

<script>
/* ================= THREE.JS SETUP ================= */
const container = document.getElementById('gameContainer');
const scene = new THREE.Scene();
scene.background = new THREE.Color(0x0a0f1d);
scene.fog = new THREE.FogExp2(0x0a0f1d, 0.015);

const camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 1000);
const renderer = new THREE.WebGLRenderer({ antialias: true, powerPreference: "high-performance" });
renderer.setSize(window.innerWidth, window.innerHeight);
renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
renderer.shadowMap.enabled = true;
renderer.shadowMap.type = THREE.PCFSoftShadowMap;
container.appendChild(renderer.domElement);

/* ================= LIGHTS ================= */
const ambientLight = new THREE.AmbientLight(0xffffff, 0.6);
scene.add(ambientLight);

const dirLight = new THREE.DirectionalLight(0xffffff, 0.8);
dirLight.position.set(20, 40, 20);
dirLight.castShadow = true;
dirLight.shadow.mapSize.width = 1024;
dirLight.shadow.mapSize.height = 1024;
scene.add(dirLight);

/* ================= GAME VARIABLES ================= */
let city = 1, stage = 1, distance = 0;
const stageLength = 1500;
let damage = 0, gameOver = false, isPaused = false;
let speed = 0, targetSpeed = 0, nitro = 100, isNitroActive = false;
let selectedCar = 0, playerX = 0, targetX = 0;
let obstacles = [], sceneryItems = [];

const input = { left: false, right: false, boost: false };

/* ================= CAR DATA ================= */
const carsData = [
    { name: "Pride 111", speed: 130, color: 0xffffff, width: 1.8, length: 3.6, height: 1.4 },
    { name: "Nissan GTR", speed: 210, color: 0x475569, width: 1.9, length: 4.4, height: 1.3 },
    { name: "McLaren 720S", speed: 250, color: 0xf97316, width: 2.0, length: 4.5, height: 1.2 },
    { name: "Ferrari F8", speed: 270, color: 0xdc2626, width: 2.0, length: 4.5, height: 1.2 },
    { name: "Lamborghini", speed: 290, color: 0x84cc16, width: 2.1, length: 4.6, height: 1.15 },
    { name: "Bugatti Chiron", speed: 330, color: 0x0284c7, width: 2.1, length: 4.7, height: 1.15 }
];

/* ================= BUILD ROAD & SCENERY ================= */
const roadGroup = new THREE.Group();
const roadGeo = new THREE.PlaneGeometry(12, 1000);
const roadMat = new THREE.MeshStandardMaterial({ color: 0x1e293b, roughness: 0.8 });
const road = new THREE.Mesh(roadGeo, roadMat);
road.rotation.x = -Math.PI / 2;
road.position.z = -450;
road.receiveShadow = true;
roadGroup.add(road);

// Line Markers
for(let i = 0; i < 50; i++) {
    const lineGeo = new THREE.PlaneGeometry(0.3, 4);
    const lineMat = new THREE.MeshBasicMaterial({ color: 0xffffff });
    const line = new THREE.Mesh(lineGeo, lineMat);
    line.rotation.x = -Math.PI / 2;
    line.position.set(0, 0.02, -i * 20);
    roadGroup.add(line);
}
scene.add(roadGroup);

/* ================= PROCEDURAL HOUSES & TREES ================= */
function createTree() {
    const group = new THREE.Group();
    const trunk = new THREE.Mesh(
        new THREE.CylinderGeometry(0.2, 0.3, 2),
        new THREE.MeshStandardMaterial({ color: 0x78350f })
    );
    trunk.position.y = 1;
    trunk.castShadow = true;
    group.add(trunk);

    const leaves = new THREE.Mesh(
        new THREE.ConeGeometry(1.5, 4, 6),
        new THREE.MeshStandardMaterial({ color: 0x15803d, roughness: 0.6 })
    );
    leaves.position.y = 3;
    leaves.castShadow = true;
    group.add(leaves);
    return group;
}

function createHouse() {
    const group = new THREE.Group();
    const h = 4 + Math.random() * 6;
    const w = 4 + Math.random() * 2;
    const body = new THREE.Mesh(
        new THREE.BoxGeometry(w, h, w),
        new THREE.MeshStandardMaterial({ color: Math.random() * 0xffffff, roughness: 0.5 })
    );
    body.position.y = h / 2;
    body.castShadow = true;
    group.add(body);

    // Roof
    const roof = new THREE.Mesh(
        new THREE.ConeGeometry(w * 0.8, 2, 4),
        new THREE.MeshStandardMaterial({ color: 0xb91c1c })
    );
    roof.position.y = h + 1;
    roof.rotation.y = Math.PI / 4;
    group.add(roof);
    return group;
}

// Populate Environment
for (let i = 0; i < 40; i++) {
    const z = -i * 25;
    // Left side
    const itemLeft = Math.random() > 0.4 ? createHouse() : createTree();
    itemLeft.position.set(-10 - Math.random() * 5, 0, z);
    scene.add(itemLeft);
    sceneryItems.push(itemLeft);

    // Right side
    const itemRight = Math.random() > 0.4 ? createHouse() : createTree();
    itemRight.position.set(10 + Math.random() * 5, 0, z);
    scene.add(itemRight);
    sceneryItems.push(itemRight);
}

/* ================= PLAYER CAR CREATION ================= */
let playerCarGroup = new THREE.Group();

function buildPlayerCar() {
    scene.remove(playerCarGroup);
    playerCarGroup = new THREE.Group();

    const data = carsData[selectedCar];
    
    // Body
    const bodyGeo = new THREE.BoxGeometry(data.width, data.height * 0.6, data.length);
    const bodyMat = new THREE.MeshStandardMaterial({ color: data.color, metalness: 0.6, roughness: 0.2 });
    const body = new THREE.Mesh(bodyGeo, bodyMat);
    body.position.y = data.height * 0.4;
    body.castShadow = true;
    playerCarGroup.add(body);

    // Cabin
    const cabinGeo = new THREE.BoxGeometry(data.width * 0.8, data.height * 0.5, data.length * 0.5);
    const cabinMat = new THREE.MeshStandardMaterial({ color: 0x111111, roughness: 0.1 });
    const cabin = new THREE.Mesh(cabinGeo, cabinMat);
    cabin.position.set(0, data.height * 0.75, -data.length * 0.05);
    playerCarGroup.add(cabin);

    // Wheels
    const wheelGeo = new THREE.CylinderGeometry(0.35, 0.35, 0.3, 16);
    const wheelMat = new THREE.MeshStandardMaterial({ color: 0x111111 });
    wheelGeo.rotateZ(Math.PI / 2);

    const positions = [
        [-data.width/2, 0.35,  data.length/3],
        [ data.width/2, 0.35,  data.length/3],
        [-data.width/2, 0.35, -data.length/3],
        [ data.width/2, 0.35, -data.length/3]
    ];

    positions.forEach(pos => {
        const wheel = new THREE.Mesh(wheelGeo, wheelMat);
        wheel.position.set(...pos);
        playerCarGroup.add(wheel);
    });

    playerCarGroup.position.set(0, 0, 0);
    scene.add(playerCarGroup);
}
buildPlayerCar();

/* ================= OBSTACLES ================= */
function spawnObstacle() {
    const geo = new THREE.BoxGeometry(1.8, 1.2, 3);
    const mat = new THREE.MeshStandardMaterial({ color: 0xd97706, roughness: 0.4 });
    const obs = new THREE.Mesh(geo, mat);
    obs.position.set((Math.random() - 0.5) * 8, 0.6, -300);
    obs.castShadow = true;
    scene.add(obs);
    obstacles.push(obs);
}

/* ================= CONTROLS ================= */
function bindControl(id, key) {
    const btn = document.getElementById(id);
    btn.addEventListener('pointerdown', (e) => { e.preventDefault(); input[key] = true; });
    btn.addEventListener('pointerup', (e) => { e.preventDefault(); input[key] = false; });
    btn.addEventListener('pointerleave', () => { input[key] = false; });
}
bindControl('left', 'left');
bindControl('right', 'right');
bindControl('boost', 'boost');

window.addEventListener('keydown', e => {
    if(e.key === 'ArrowLeft') input.left = true;
    if(e.key === 'ArrowRight') input.right = true;
    if(e.key === 'ArrowUp') input.boost = true;
});
window.addEventListener('keyup', e => {
    if(e.key === 'ArrowLeft') input.left = false;
    if(e.key === 'ArrowRight') input.right = false;
    if(e.key === 'ArrowUp') input.boost = false;
});

/* ================= UTILS & UI ================= */
function fa(n) { return Math.floor(n).toLocaleString('fa-IR'); }

function showMessage(title, text) {
    document.getElementById("messageTitle").textContent = title;
    document.getElementById("messageText").textContent = text;
    document.getElementById("message").classList.add("show");
}

function openGarage() {
    isPaused = true;
    let listHtml = carsData.map((c, i) => `
        <div class="carCard ${i === selectedCar ? 'selected' : ''}" onclick="selectCar(${i})">
            <b>${c.name}</b><br>
            <small style="color:#aaa">سرعت: ${c.speed} km/h</small>
        </div>
    `).join('');
    
    document.getElementById("panelContent").innerHTML = `
        <h1>🚗 گاراژ و انتخاب ماشین</h1>
        <div class="carGrid">${listHtml}</div>
        <button class="primaryBtn" onclick="closeGarage()">بازگشت به بازی</button>
    `;
    document.getElementById("message").classList.add("show");
}

function selectCar(i) {
    selectedCar = i;
    buildPlayerCar();
    openGarage();
}

function closeGarage() {
    isPaused = false;
    document.getElementById("panelContent").innerHTML = `
        <h1 id="messageTitle"></h1>
        <p id="messageText"></p>
        <button class="primaryBtn" id="nextButton">ادامه</button>
    `;
    document.getElementById("nextButton").onclick = handleNext;
    document.getElementById("message").classList.remove("show");
}

document.getElementById("garageBtn").onclick = openGarage;

/* ================= GAME LOOP ================= */
function update() {
    if(gameOver || isPaused) return;

    const car = carsData[selectedCar];
    isNitroActive = input.boost && nitro > 0;

    if(isNitroActive) {
        targetSpeed = car.speed * 1.3;
        nitro = Math.max(0, nitro - 0.6);
    } else {
        targetSpeed = car.speed;
        nitro = Math.min(100, nitro + 0.2);
    }

    speed += (targetSpeed - speed) * 0.03;
    
    // Steering
    if(input.left) targetX -= 0.15;
    if(input.right) targetX += 0.15;
    targetX = Math.max(-4, Math.min(4, targetX));
    playerX += (targetX - playerX) * 0.1;
    playerCarGroup.position.x = playerX;
    playerCarGroup.rotation.z = -(targetX - playerX) * 0.1; // Smooth Banking Effect

    const moveStep = speed * 0.03;
    distance += speed * 0.01;

    // Environment Endless Scroll
    sceneryItems.forEach(item => {
        item.position.z += moveStep;
        if(item.position.z > 20) item.position.z -= 1000;
    });

    // Obstacles Management
    if(Math.random() < 0.03) spawnObstacle();
    for(let i = obstacles.length - 1; i >= 0; i--) {
        let obs = obstacles[i];
        obs.position.z += moveStep;

        // Collision Check
        if(Math.abs(obs.position.z - playerCarGroup.position.z) < 2 && Math.abs(obs.position.x - playerCarGroup.position.x) < 1.5) {
            scene.remove(obs);
            obstacles.splice(i, 1);
            damage++;
            document.getElementById("damage").textContent = `آسیب: ${fa(damage)} / ۲`;
            if(damage >= 2) {
                gameOver = true;
                showMessage("💥 برخورد شدید!", "ماشین شما نابود شد.");
            }
            continue;
        }

        if(obs.position.z > 20) {
            scene.remove(obs);
            obstacles.splice(i, 1);
        }
    }

    // Camera Smooth Follow
    camera.position.set(playerCarGroup.position.x * 0.3, 3.5, 7);
    camera.lookAt(playerCarGroup.position.x * 0.5, 1, -10);

    // Stage End Check
    if(distance >= stageLength) {
        gameOver = true;
        if(stage < 50) showMessage("🏁 مرحله تمام شد!", `مرحله ${fa(stage)} با موفقیت طی شد.`);
        else showMessage("🏆 قهرمان کل شهرها!", "شما تمام ۵۰ مرحله را به پایان رساندید!");
    }

    // HUD Updates
    document.getElementById("nitroBar").style.width = `${nitro}%`;
    document.getElementById("speedText").textContent = `${fa(Math.round(speed))} km/h`;
    document.getElementById("distanceText").textContent = `${fa(Math.min(Math.floor(distance), stageLength))} / ${fa(stageLength)} متر`;
    document.getElementById("stageText").textContent = `شهر ${fa(city)} - مرحله ${fa(stage)}/۵۰`;
}

function handleNext() {
    damage = 0; distance = 0; playerX = targetX = 0; gameOver = false;
    obstacles.forEach(o => scene.remove(o));
    obstacles = [];
    document.getElementById("damage").textContent = "آسیب: ۰ / ۲";
    if(damage < 2) { stage++; if(stage % 10 === 1) city++; }
    document.getElementById("message").classList.remove("show");
}
document.getElementById("nextButton").onclick = handleNext;

function animate() {
    requestAnimationFrame(animate);
    update();
    renderer.render(scene, camera);
}
animate();

/* ================= RESIZE EVENT ================= */
window.addEventListener('resize', () => {
    camera.aspect = window.innerWidth / window.innerHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(window.innerWidth, window.innerHeight);
});
</script>
</body>
</html>
